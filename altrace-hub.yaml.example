# Altrace Hub — Production Configuration
# Deploy target: altrace.io
# Generated: 2026-02-25
#
# SECRETS: DATABASE_URL and provider API keys must be set via environment
# variables. Never commit real credentials to this file.

hub:
  listen_addr: "0.0.0.0:8443"
  auto_migrate: true
  stale_threshold: "90s"

  # Database — override with DATABASE_URL env var in production.
  # For local dev: postgres://altrace:altrace@localhost:5432/altrace?sslmode=disable
  database_url: ""

  # TLS — required for production. Paths are container-internal.
  # In local dev, leave empty to serve plain HTTP.
  tls:
    cert_file: "/etc/altrace-hub/tls/tls.crt"
    key_file: "/etc/altrace-hub/tls/tls.key"

  # RBAC — token-based authentication for all hub API endpoints.
  rbac:
    enabled: true
    tokens:
      # Admin: full access — console login, policy management, kill switches
      # Use this token to log into the web console at altrace.io
      - token: "CHANGE-ME-BEFORE-USE"
        role: "admin"
        description: "Admin user"

      # Operator: kill switches, fleet view, budget management (no policy creation)
      - token: "CHANGE-ME-BEFORE-USE"
        role: "operator"
        description: "On-call operator"

      # Sidecar: heartbeat, policy fetch/ack, causal record ingest
      - token: "CHANGE-ME-BEFORE-USE"
        role: "sidecar"
        description: "Fleet sidecar identity"

  # SSE — real-time push for kill switch, policy updates, approval events
  sse:
    heartbeat_interval: "15s"
    max_connections: 200

  # Budget — fleet-wide budget rebalancing
  budget:
    sync_interval: "60s"
    safety_margin: 0.10

  # Telemetry — event retention and batch ingestion
  telemetry:
    retention_days: 90
    batch_max_size: 1000

  # CORS — allow the web console to make API calls to the hub.
  # nginx proxies /api/* so CORS is only needed if the console
  # hits the hub directly (e.g., during local dev without nginx).
  cors:
    allowed_origins:
      - "https://altrace.io"
      - "https://www.altrace.io"
      - "http://localhost"
      - "http://localhost:80"
    allowed_methods:
      - "GET"
      - "POST"
      - "PUT"
      - "DELETE"
      - "OPTIONS"
    allowed_headers:
      - "Content-Type"
      - "Authorization"
      - "X-Altrace-Request-ID"
    max_age: 3600
